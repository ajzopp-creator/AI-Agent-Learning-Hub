# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git! (it's in .gitignore)

# ============================================
# LM Studio Configuration
# ============================================
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_API_KEY=not-needed-for-local
DEFAULT_MODEL=mistral-7b-instruct-v0.2
MAX_TOKENS=2000
TEMPERATURE=0.7

# ============================================
# Email Configuration (for Email Agent)
# ============================================
# Gmail Example:
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
EMAIL_SERVER=imap.gmail.com
EMAIL_PORT=993

# Outlook Example (uncomment if using Outlook):
# EMAIL_ADDRESS=your.email@outlook.com
# EMAIL_PASSWORD=your_password_here
# EMAIL_SERVER=outlook.office365.com
# EMAIL_PORT=993

# ============================================
# Schwab API Configuration (for Trading Agent)
# ============================================
# Get these from: https://developer.schwab.com/
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_ACCOUNT_ID=your_account_number_here

# OAuth tokens (generated by your app, don't fill manually)
SCHWAB_ACCESS_TOKEN=
SCHWAB_REFRESH_TOKEN=

# Paper Trading vs Live (ALWAYS start with paper!)
SCHWAB_PAPER_TRADING=True

# ============================================
# Cloud LLM APIs (Optional)
# ============================================
# Only if you want to use cloud LLMs instead of LM Studio

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# Alert Configuration
# ============================================
# For notifications when trading agent takes action
ALERT_EMAIL=your.alerts@email.com
ALERT_PHONE=+1234567890  # Format: +1234567890

# ============================================
# Risk Management Settings
# ============================================
# These are defaults, can be overridden in config files
DEFAULT_RISK_PER_TRADE=0.01  # 1% of account
MAX_DAILY_LOSS=500  # Dollar amount
MAX_POSITION_SIZE=0.20  # 20% of account
MAX_TRADES_PER_DAY=5

# ============================================
# Database Configuration (if using)
# ============================================
DATABASE_URL=sqlite:///trading_data.db

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=True
LOG_DIRECTORY=./logs

# ============================================
# Development vs Production
# ============================================
ENVIRONMENT=development  # development or production
DEBUG_MODE=True

# ============================================
# API Rate Limits
# ============================================
# To avoid hitting API limits
SCHWAB_MAX_REQUESTS_PER_MINUTE=60
EMAIL_CHECK_INTERVAL_MINUTES=60

# ============================================
# Feature Flags
# ============================================
# Enable/disable features during development
ENABLE_EMAIL_AGENT=False
ENABLE_TRADING_AGENT=False  # Only enable when ready!
ENABLE_AUTO_TRADING=False   # EXTREME CAUTION!

# ============================================
# IMPORTANT NOTES
# ============================================
# 
# 1. CREATE .env FILE:
#    - Copy this file to .env
#    - Fill in your actual values
#    - NEVER commit .env to Git
#    - It's already in .gitignore
#
# 2. APP-SPECIFIC PASSWORDS:
#    - Gmail: https://myaccount.google.com/apppasswords
#    - Requires 2-factor authentication
#    - Generate new password specifically for this app
#
# 3. SCHWAB API:
#    - Apply for access at developer.schwab.com
#    - May take days/weeks for approval
#    - Start with paper trading account
#
# 4. SECURITY:
#    - Never share .env file
#    - Never commit API keys
#    - Rotate keys regularly
#    - Use different keys for dev/prod
#
# 5. TESTING:
#    - Set ENVIRONMENT=development while learning
#    - Set DEBUG_MODE=True for verbose logging
#    - Disable auto-trading until thoroughly tested
#
# ============================================
# LOADING IN PYTHON
# ============================================
#
# To use these variables in your Python code:
#
# from dotenv import load_dotenv
# import os
#
# load_dotenv()  # Load .env file
#
# email = os.getenv('EMAIL_ADDRESS')
# password = os.getenv('EMAIL_PASSWORD')
#
# ============================================
