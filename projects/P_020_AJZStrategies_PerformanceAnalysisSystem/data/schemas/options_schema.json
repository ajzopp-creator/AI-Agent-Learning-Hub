{
  "template_name": "Options Trade Log",
  "version": "1.0",
  "description": "Schema for P_020 Options trade log. source=parser means the importer writes this column. source=formula means Excel owns it - hands off.",
  "columns": [
    {"name": "Symbol",        "type": "string",  "source": "parser"},
    {"name": "System",        "type": "string",  "source": "parser"},
    {"name": "Trade Type",    "type": "string",  "source": "parser"},
    {"name": "Long/Short",    "type": "string",  "source": "parser"},
    {"name": "Strike",        "type": "number",  "source": "parser"},
    {"name": "Cur Stock $",   "type": "number",  "source": "parser"},
    {"name": "Trade Date",    "type": "date",    "source": "parser"},
    {"name": "Entry $$",      "type": "number",  "source": "parser"},
    {"name": "Contracts",     "type": "number",  "source": "parser"},
    {"name": "Exit #1 $",     "type": "number",  "source": "parser"},
    {"name": "# Exited",      "type": "number",  "source": "parser"},
    {"name": "Exit Date",     "type": "date",    "source": "parser"},
    {"name": "# of Days",     "type": "number",  "source": "formula"},
    {"name": "Exit #2 $",     "type": "number",  "source": "parser"},
    {"name": "# Exited2",     "type": "number",  "source": "parser"},
    {"name": "Exit Date3",    "type": "date",    "source": "parser"},
    {"name": "# of Days4",    "type": "number",  "source": "formula"},
    {"name": "Exit #3 $",     "type": "number",  "source": "parser"},
    {"name": "# Exited5",     "type": "number",  "source": "parser"},
    {"name": "Exit Date6",    "type": "date",    "source": "parser"},
    {"name": "# of Days7",    "type": "number",  "source": "formula"},
    {"name": "Comm.",         "type": "number",  "source": "parser"},
    {"name": "Gain/Loss",     "type": "number",  "source": "formula"},
    {"name": "Trade Comments","type": "string",  "source": "parser"},
    {"name": "Exit #1",       "type": "number",  "source": "formula"},
    {"name": "Exit #2",       "type": "number",  "source": "formula"},
    {"name": "Exit #3",       "type": "number",  "source": "formula"}
  ]
}
