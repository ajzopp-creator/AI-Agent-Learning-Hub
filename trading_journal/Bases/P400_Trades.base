filters:
  and:
    - file.inFolder("TradeOrderManagement/P400")
properties:
  run_date:
    displayName: Date
  ticker:
    displayName: Ticker
  account_id:
    displayName: Account
  council_verdict:
    displayName: Verdict
  lifecycle_status:
    displayName: Status
  realized_pnl:
    displayName: P&L
  why_code:
    displayName: Why
views:
  - type: table
    name: Table
    order:
      - run_date
      - ticker
      - account_id
      - council_verdict
      - lifecycle_status
      - realized_pnl
      - why_code
    sort:
      - property: run_date
        direction: DESC
