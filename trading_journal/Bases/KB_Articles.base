filters:
  and:
    - file.inFolder("KnowledgeBase")
properties:
  date:
    displayName: Date
  title:
    displayName: Title
  kb_type:
    displayName: Type
  origin:
    displayName: Origin
  tags:
    displayName: Tags
  ticker_relevance:
    displayName: Ticker Relevance
  sector:
    displayName: Sector
views:
  - type: table
    name: Table
    order:
      - date
      - title
      - kb_type
      - origin
      - tags
      - ticker_relevance
      - sector
    sort:
      - property: date
        direction: DESC
