filters:
  and:
    - file.inFolder("TradeOrderManagement/P300")
properties:
  date:
    displayName: Date
  ticker:
    displayName: Ticker
  signal:
    displayName: Signal
  signal_horizon:
    displayName: Horizon
  h5_win_rate:
    displayName: H5 Win Rate
  h10_win_rate:
    displayName: H10 Win Rate
  h5_mean_ret:
    displayName: H5 Mean Return
  n_matches:
    displayName: N Matches
views:
  - type: table
    name: Table
    filters:
      and:
        - file.ctime > "2026-05-25"
        - source.contains("P300")
        - signal.contains("WATCH")
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - date
      - ticker
      - signal
      - signal_horizon
      - h5_win_rate
      - h10_win_rate
      - h5_mean_ret
      - n_matches
    sort:
      - property: file.ctime
        direction: ASC
