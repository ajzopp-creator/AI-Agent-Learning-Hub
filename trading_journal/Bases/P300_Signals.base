view: table
filter:
  conditions:
    - field: file.folder
      operator: contains
      value: TradeManagement/P300
  conjunction: and
sort:
  - field: date
    direction: desc
columns:
  - id: date
    field: date
  - id: ticker
    field: ticker
  - id: signal
    field: signal
  - id: signal_horizon
    field: signal_horizon
  - id: h5_win_rate
    field: h5_win_rate
  - id: h10_win_rate
    field: h10_win_rate
  - id: h5_mean_ret
    field: h5_mean_ret
  - id: n_matches
    field: n_matches
views:
  - type: table
    name: Table
    filters:
      and:
        - file.ctime > "2026-05-25"
        - source.contains("P300")
        - signal.contains("WATCH")
    groupBy:
      property: file.tags
      direction: ASC
    sort:
      - property: file.ctime
        direction: ASC
