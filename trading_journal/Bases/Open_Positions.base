filters:
  or:
    - lifecycle_status == "OPEN"
    - and:
        - traded == "Y"
        - outcome.isEmpty()
properties:
  date:
    displayName: Date
  ticker:
    displayName: Ticker
  source:
    displayName: Source
  entry_price:
    displayName: Entry
  stop_price:
    displayName: Stop
  target_1:
    displayName: Target 1
  account_id:
    displayName: Account
views:
  - type: cards
    name: Table
    order:
      - date
      - ticker
      - source
      - entry_price
      - stop_price
      - target_1
      - account_id
    sort:
      - property: date
        direction: ASC
