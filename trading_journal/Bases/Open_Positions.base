view: table
filter:
  conditions:
    - field: lifecycle_status
      operator: eq
      value: OPEN
  conjunction: or
  groups:
    - conditions:
        - field: traded
          operator: eq
          value: Y
        - field: outcome
          operator: isEmpty
          value: ""
      conjunction: and
sort:
  - field: date
    direction: asc
columns:
  - id: date
    field: date
  - id: ticker
    field: ticker
  - id: source
    field: source
  - id: entry_price
    field: entry_price
  - id: stop_price
    field: stop_price
  - id: target_1
    field: target_1
  - id: account_id
    field: account_id
views:
  - type: cards
    name: Table
