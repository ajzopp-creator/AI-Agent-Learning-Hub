filters:
  and:
    - file.inFolder("TradeOrderManagement/P115")
properties:
  date:
    displayName: Date
  symbol:
    displayName: Symbol
  step1_verdict:
    displayName: Step 1 Verdict
  setup_score:
    displayName: Setup Score
  traded:
    displayName: Traded
  outcome:
    displayName: Outcome
  why_code:
    displayName: Why
views:
  - type: table
    name: Table
    order:
      - date
      - symbol
      - step1_verdict
      - setup_score
      - traded
      - outcome
      - why_code
    sort:
      - property: date
        direction: DESC
