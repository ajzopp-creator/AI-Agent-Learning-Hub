filters:
  and:
    - file.inFolder("TradeOrderManagement/P020")
properties:
  close_date:
    displayName: Close Date
  symbol:
    displayName: Symbol
  account_id:
    displayName: Account
  system:
    displayName: System
  realized_pnl:
    displayName: P&L
  realized_R:
    displayName: R
  outcome:
    displayName: Outcome
  sig_code:
    displayName: Sig
views:
  - type: table
    name: Table
    order:
      - close_date
      - symbol
      - account_id
      - system
      - realized_pnl
      - realized_R
      - outcome
      - sig_code
    sort:
      - property: close_date
        direction: DESC
