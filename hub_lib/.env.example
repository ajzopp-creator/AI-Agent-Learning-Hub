# hub_lib local environment template.
# Copy to:  C:\Users\Trader\AI-Agent-Learning-Hub\.env
# Then fill in your API keys. Add .env to .gitignore.
#
# NOTE: Variable names match the existing Hub root .env.example
# (GOOGLE_API_KEY, ANTHROPIC_API_KEY) so a single .env serves both
# hub_lib and your other projects.

# ── API KEYS ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── OPTIONAL TASK ROUTING OVERRIDES ──────────────────────────────────────────
# Format:  HUBLIB_TASK_<TASKNAME>=provider:model_id
# Examples:
# HUBLIB_TASK_VP_PATTERN=google:gemini-2.5-pro
# HUBLIB_TASK_CLOUD_FAST=anthropic:claude-haiku-4-5-20251001
